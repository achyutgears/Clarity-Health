# Clarity Health environment variables — names and descriptions only, never real values.
# `.env` is managed by Lovable Cloud and committed; it must only ever hold public values.
# Put anything you add yourself in `.env.local` (gitignored via *.local).

# --- Supabase (Lovable Cloud) — public, safe in the browser bundle ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# Same values read on the server during SSR.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# --- Server-only secrets — never prefix with VITE_, never commit ---
# SUPABASE_SERVICE_ROLE_KEY=<service role key; provided by Lovable Cloud at runtime>

# --- Optional: Google Places API (New) for Find Care ---
# Public browser key, so it ships in the client bundle. Restrict it in Google Cloud Console:
#   Application restrictions: HTTP referrers (http://localhost:8080/*, https://<your-domain>/*)
#   API restrictions: Places API (New) only.
# Without it, Find Care uses OpenStreetMap (Nominatim + Overpass), which needs no key.
VITE_GOOGLE_MAPS_API_KEY=
